# База данных
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=gorky_db

# Подключение к БД для бэкенда (хост - postgres)
DATABASE_URL=postgresql://postgres:your_secure_password@postgres:5432/gorky_db

# Порты сервисов
BACKEND_PORT=8000
FRONTEND_PORT=3000

# LLM: любой OpenAI-совместимый провайдер.
# По умолчанию у нас Gemini через OpenAI-совместимый адрес (ниже).
# Пустой LLM_BASE_URL — адрес OpenAI (api.openai.com).
# LLM_MODEL — имя модели у выбранного провайдера.
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash
