# Перечень переменных окружения (значения — только примеры).
# Скопируйте в .env и заполните. .env в репозиторий не коммитится.

# База данных (контейнер postgres). Пароль — из букв и цифр: он подставляется в адрес
# подключения без экранирования.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=hackathon_db
POSTGRES_PORT=5432

# Подключение к базе для бэкенда и тестов, запущенных с хоста (uv run ...).
# Внутри Docker бэкенд получает адрес из docker-compose.yaml (хост postgres).
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/hackathon_db

# Порты сервисов на 127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# LLM: любой OpenAI-совместимый провайдер.
# По умолчанию у нас Gemini через OpenAI-совместимый адрес (ниже).
# Пустой LLM_BASE_URL — адрес OpenAI (api.openai.com).
# LLM_MODEL — имя модели у выбранного провайдера.
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=

# Распознавание речи (POST /api/stt): Gemini, нативный API — отдельно от LLM_*.
# Ключ серверный: пользовательские настройки LLM на распознавание не влияют.
# Может совпадать с LLM_API_KEY, если это ключ Gemini. Пусто — /api/stt отвечает 503.
# STT_MODEL — модель Gemini, которая принимает аудио, напр. gemini-3.5-flash-lite.
# STT_THINKING_LEVEL — необязательно: уровень «обдумывания» модели (thinkingLevel Gemini),
# напр. minimal или low; допустимые значения зависят от модели. Пусто — как задано у модели.
STT_API_KEY=your_gemini_api_key_here
STT_MODEL=
STT_THINKING_LEVEL=

# Демо-учётки с датасетом 1000 записей (для жюри и для команды): JSON-объект «логин → пароль»
# в одинарных кавычках. Недостающие создаются сами при старте бэкенда; сброс к датасету —
# `python -m scripts.demo_accounts --reset <логин>` (или --reset-all). Логин — 3–32 символа:
# латиница, цифры, _ . -; пароль — 8–128 символов, любые. Пусто — демо-учёток нет.
# Пароли ниже выдуманные: настоящие на сервере вписывает техлид.
DEMO_ACCOUNTS='{"jury": "example-jury-password", "denis": "example-denis-password"}'

# Поиск по смыслу: 1 — при старте бэкенда в фоне загрузить модель и посчитать векторы
# стартового набора (~15 с на одном ядре), чтобы первый поиск их не ждал. В образе бэкенда
# уже 1 (Dockerfile); для локального запуска и тестов не нужно.
SEARCH_WARMUP=

# CORS: адреса фронтенда через запятую. Пусто — gorky.bond и localhost:3000/5173.
CORS_ORIGINS=
