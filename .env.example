# Перечень переменных окружения (без значений).
# Скопируйте в .env и заполните локально. .env в репозиторий не коммитится.

# Настройки локальной базы данных
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=hackathon_db
POSTGRES_PORT=5432

# Подключение к базе для бэкенда
DATABASE_URL=postgresql://postgres:postgres_password@postgres:5432/hackathon_db

# Порты сервисов
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Секреты для ИИ
GEMINI_API_KEY=your_gemini_api_key_here